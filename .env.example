# All values intentionally blank. Supply unique credentials only when deploying.
# The server does not load this file; export values securely. Only the laptop
# demo bot (python3 -m estate.polling) reads a local copy named .env.
ESTATE_ADMIN_TOKEN=
ESTATE_PUBLIC_BASE_URL=
ESTATE_MEDIA_SIGNING_KEY=

# Example per-realtor environment variable names, entered in the admin form.
REALTOR_TELEGRAM_TOKEN=
REALTOR_INSTAGRAM_TOKEN=
REALTOR_WEBHOOK_SECRET=
REALTOR_INSTAGRAM_APP_SECRET=

# Laptop demo bot only (python3 -m estate.polling). Copy this file to .env.
# Token from @BotFather /newbot. Realtor IDs are numeric Telegram user IDs,
# comma-separated. Contact is shown to clients on handover, e.g. @your_username.
# Channel is optional: a channel where the bot is an admin; its posts become listings.
ESTATE_DEMO_BOT_TOKEN=
ESTATE_DEMO_REALTOR_IDS=
ESTATE_DEMO_REALTOR_CONTACT=
ESTATE_DEMO_CHANNEL=

# Optional AI replies (bot and server). Blank key = rule-based replies only.
# Key from console.anthropic.com; usage is billed. Needs: pip install anthropic
# Model defaults to claude-opus-5-5; set ESTATE_AI_MODEL to use another one.
ANTHROPIC_API_KEY=
ESTATE_AI_MODEL=

# Optional local voice transcription. Install binaries/model separately.
WHISPER_CPP_BIN=
WHISPER_MODEL_PATH=
FFMPEG_BIN=

# Jira remains disabled. Configure GitHub Actions secrets later, not this file.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
